<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked rather than referenced, exactly as TextCleaner.Tests does it: the app
         targets net10.0-windows and cannot run on macOS, but RealtimeProtocol is pure, so
         compiling it into this plain net10.0 assembly makes the wire format testable off
         the VM. Same-assembly compilation also reaches its internal members without an
         InternalsVisibleTo. -->
    <Compile Include="../../RealtimeProtocol.cs" Link="RealtimeProtocol.cs" />
  </ItemGroup>

</Project>
