<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Runs on Windows 10 1809 and later; every API used exists in 1809. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>SelectAndRead</AssemblyName>
    <RootNamespace>SelectAndRead</RootNamespace>

    <!-- The single source of truth for releases (SPEC 12.3). Bumping this integer and
         pushing to main is the whole release process: .github/workflows/release.yml reads
         it back out of this file, and publishes a tagged Release when it has changed.
         Note that app.manifest carries its own version - that is the Win32 side-by-side
         identity, which is unrelated and deliberately left alone. -->
    <Version>7</Version>
    <!-- Spelled out rather than left to default from Version, which would hand Roslyn a
         major-only "1" to validate as an assembly version. The tray menu reads
         InformationalVersion, which does default from Version and stays the bare integer. -->
    <AssemblyVersion>$(Version).0.0.0</AssemblyVersion>
    <FileVersion>$(Version).0.0.0</FileVersion>
    <!-- Without this the SDK appends "+<commit-sha>" to InformationalVersion, which the
         tray menu shows verbatim. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Mirrors the tray icon TrayAppContext.CreateTrayIcon draws at runtime. The tray
         icon is still drawn in code rather than loaded from here, because it is built at
         one fixed size for one purpose; this file is what Explorer, the Start menu
         shortcut and the Add/Remove Programs entry show, and without it all three fall
         back to the generic default. Both are the same mark, so keep them in step. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- WFO0003 asks us to declare DPI awareness via ApplicationHighDpiMode instead of
         the manifest. We deliberately do the opposite: the manifest is applied by the
         loader before any managed code runs, whereas Application.SetHighDpiMode only
         takes effect if nothing has already created a window. For an app whose core
         feature is pixel-exact screen geometry, the earlier and stricter mechanism
         wins. Program.cs correspondingly does NOT call ApplicationConfiguration
         .Initialize(), which would emit a contradicting SetHighDpiMode call. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Allows building this Windows-targeted project from macOS/Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Trimming breaks WinForms reflection over designer types. Never enable it. -->
    <PublishTrimmed>false</PublishTrimmed>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives under tests/ and compiles its own copy of TextCleaner.cs;
         without this the default glob would pull the test sources in here too. -->
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
