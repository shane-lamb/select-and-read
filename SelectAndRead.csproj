<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Runs on Windows 10 1809 and later; every API used exists in 1809. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>SelectAndRead</AssemblyName>
    <RootNamespace>SelectAndRead</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 asks us to declare DPI awareness via ApplicationHighDpiMode instead of
         the manifest. We deliberately do the opposite: the manifest is applied by the
         loader before any managed code runs, whereas Application.SetHighDpiMode only
         takes effect if nothing has already created a window. For an app whose core
         feature is pixel-exact screen geometry, the earlier and stricter mechanism
         wins. Program.cs correspondingly does NOT call ApplicationConfiguration
         .Initialize(), which would emit a contradicting SetHighDpiMode call. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Allows building this Windows-targeted project from macOS/Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Trimming breaks WinForms reflection over designer types. Never enable it. -->
    <PublishTrimmed>false</PublishTrimmed>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives under tests/ and compiles its own copy of TextCleaner.cs;
         without this the default glob would pull the test sources in here too. -->
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
